# Copia este archivo a .env y llena los valores reales. .env nunca se commitea.

# Dominio real de producción (Segmento 5, antes de desplegar).
PUBLIC_SITE_URL=https://tu-dominio-real.com

# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX) o contenedor de
# Google Tag Manager (GTM-XXXXXXX, detectado por prefijo en Analytics.astro).
# Si se deja vacío, el snippet no se inyecta (Analytics.astro).
PUBLIC_GA_MEASUREMENT_ID=

# URL "/exec" del Google Apps Script Web App que recibe los registros del
# formulario de /masterclass (nombre, correo, negocio, teléfono) y los agrega
# a una Google Sheet + envía notificación por correo. No es secreta (es un
# endpoint público de recepción, como el link de WhatsApp ya hardcodeado) —
# ver project_state.md para el paso a paso de cómo publicarla.
# Si se deja vacío, el formulario sigue funcionando mas no envía nada a
# ningún lado (solo se registra un aviso en la consola del navegador).
PUBLIC_LEADS_ENDPOINT=


# Pendiente — API de CLARVO (onboarding, cuentas). Vacío hasta tener URL de producción.
PUBLIC_CLARVO_API_BASE_URL=

# Pendiente — flujo de alta de cuenta.
PUBLIC_CLARVO_ONBOARDING_URL=

# Pendiente — app oficial (login).
PUBLIC_CLARVO_APP_URL=

# Site key de Google reCAPTCHA v2 (Checkbox) para el widget anti-bot del
# último paso del onboarding (hallazgo M-06, sonar_1.1.html Fase D,
# portalFac punto 410; migrado de Cloudflare Turnstile, 2026-11-12 — ver
# portalFac/DOCS/recaptcha.html). Es pública a propósito (va en el HTML,
# Google la valida junto con el dominio real). Si se deja vacío, usa el
# site key PÚBLICO de prueba que documenta Google (siempre aprueba) —
# solo para desarrollo, nunca ponerlo así en producción real.
PUBLIC_RECAPTCHA_SITE_KEY=

# Solo local, para scripts/generate-images.mjs — nunca se usa en el build del sitio.
OPENAI_API_KEY=
