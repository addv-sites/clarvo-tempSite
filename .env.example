# Copia este archivo a .env y llena los valores reales. .env nunca se commitea.

# Dominio real de producción (Segmento 5, antes de desplegar).
PUBLIC_SITE_URL=https://tu-dominio-real.com

# Google Analytics 4 — Measurement ID (formato G-XXXXXXXXXX).
# Si se deja vacío, el snippet de GA4 no se inyecta (Analytics.astro).
PUBLIC_GA_MEASUREMENT_ID=

# URL "/exec" del Google Apps Script Web App que recibe los registros del
# formulario de /masterclass (nombre, correo, negocio, teléfono) y los agrega
# a una Google Sheet + envía notificación por correo. No es secreta (es un
# endpoint público de recepción, como el link de WhatsApp ya hardcodeado) —
# ver project_state.md para el paso a paso de cómo publicarla.
# Si se deja vacío, el formulario sigue funcionando mas no envía nada a
# ningún lado (solo se registra un aviso en la consola del navegador).
PUBLIC_LEADS_ENDPOINT=

