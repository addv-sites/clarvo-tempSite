---
import "../styles/global.css";
import Analytics from "../components/Analytics.astro";
import CookieConsent from "../components/site/CookieConsent.astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "CLARVO",
  description,
  url: Astro.site?.toString(),
};
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#050b1c" />
    {noindex && <meta name="robots" content="noindex" />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:image" content={new URL("/images/site/og-cover.png", Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/images/site/og-cover.png", Astro.site).toString()} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />

    <Analytics />
  </head>
  <body class="overflow-x-hidden bg-gradient-to-br from-[#050b1c] to-[#0f1f4a] text-white antialiased">
    <slot />
    <CookieConsent />
  </body>
</html>
