---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import HeroSection from "../components/site/HeroSection.astro";
import DashboardDemoSection from "../components/site/DashboardDemoSection.astro";
import ProblemSection from "../components/site/ProblemSection.astro";
import SolutionSection from "../components/site/SolutionSection.astro";
import FeatureGrid from "../components/site/FeatureGrid.astro";
import PricingSection from "../components/site/PricingSection.astro";
import CotizadorSection from "../components/site/CotizadorSection.astro";
import TestimonialsSection from "../components/site/TestimonialsSection.astro";
import FaqSection from "../components/site/FaqSection.astro";
import FinalCta from "../components/site/FinalCta.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import { plans } from "../data/plans";
import { faqs } from "../data/faq";

const siteUrl = Astro.site?.toString() ?? "https://clarvo.mx";

// Datos estructurados — master prompt sección 17. Solo atributos
// confirmados: sin aggregateRating/review (no hay reseñas reales todavía),
// sin afirmar que CLARVO timbra CFDI ante el SAT directamente. Offers
// toma precio/nombre de src/data/plans.ts, la misma fuente que renderiza
// la sección de Planes — nunca se duplican números a mano.
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "CLARVO",
  url: siteUrl,
  inLanguage: "es-MX",
};

const softwareApplicationJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "CLARVO",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description:
    "Portal de gestión para emprendedores: ventas, cobros, gastos, inventario y solicitudes de facturación en un solo lugar.",
  url: siteUrl,
  offers: plans.map((plan) => ({
    "@type": "Offer",
    name: plan.name,
    price: plan.monthly,
    priceCurrency: "MXN",
    url: `${siteUrl}#planes`,
  })),
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---

<Layout
  title="CLARVO — Tu negocio bajo control"
  description="Organiza, administra y haz crecer tu negocio en un solo lugar. Ventas, clientes, inventario, gastos, reportes y facturas, sin complicaciones."
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(softwareApplicationJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <SiteHeader />
  <main class="bg-surface-deep">
    <HeroSection />
    <DashboardDemoSection />
    <ProblemSection />
    <SolutionSection />
    <FeatureGrid />
    <PricingSection />
    <CotizadorSection />
    <TestimonialsSection />
    <FaqSection />
    <FinalCta />
  </main>
  <SiteFooter />
</Layout>

<script>
  // Reveal-on-scroll: mismo patrón que /masterclass (IntersectionObserver,
  // nunca `scroll` continuo — ver skill low-impact-motion).
  const revealTargets = document.querySelectorAll(".reveal");
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 },
  );
  revealTargets.forEach((el) => revealObserver.observe(el));
</script>
