---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import CommunityCta from "../components/CommunityCta.astro";
import FeatureIcons from "../components/FeatureIcons.astro";
import DashboardMockup from "../components/DashboardMockup.astro";
import Footer from "../components/Footer.astro";
import { Quote } from "@lucide/astro";
---

<Layout
  title="CLARVO — Tu portal de gestión | Sitio en construcción"
  description="CLARVO es el portal de gestión que le da a tu negocio control de ventas, cobros, inventario y facturación en un solo lugar. Sé de los primeros en acceder."
>
  <main class="mx-auto max-w-6xl px-6 py-8">
    <div class="flex justify-end gap-3 text-xs text-slate-400">
      <span>SITIO EN CONSTRUCCIÓN</span>
      <span aria-hidden="true" class="text-slate-600">——</span>
      <span>Algo grande está por llegar</span>
    </div>

    <div class="mt-10 grid gap-20 lg:grid-cols-2 lg:items-center">
      <div>
        <Logo size="hero" />

        <p class="mt-12 text-xs font-semibold tracking-[0.2em] text-slate-400">
          MÁS QUE UN SISTEMA.
        </p>
        <h1 class="mt-3 text-4xl font-extrabold leading-tight sm:text-5xl">
          El control que<br />
          tu negocio <span class="text-brand-cyan">necesita.</span>
        </h1>
        <p class="mt-6 max-w-md text-slate-300">
          Estamos afinando cada detalle para darte la mejor experiencia. Muy
          pronto podrás acceder a CLARVO y empezar a organizar, controlar y
          hacer crecer tu negocio en un solo lugar.
        </p>

        <div class="mt-8">
          <CommunityCta />
        </div>
      </div>

      <div class="relative flex justify-center lg:justify-end">
        <div class="w-full max-w-xl">
          <DashboardMockup />
        </div>
      </div>
    </div>

    <div class="mt-24 grid gap-10 lg:grid-cols-[1fr_auto] lg:items-start">
      <FeatureIcons />

      <div class="flex max-w-xs items-start gap-3 rounded-2xl border border-brand-border bg-brand-card/60 p-5">
        <Quote class="h-5 w-5 shrink-0 text-brand-cyan" />
        <p class="text-sm text-slate-200">
          Un emprendedor con claridad, llega más lejos.
        </p>
      </div>
    </div>
  </main>

  <div class="mt-24">
    <Footer />
  </div>
</Layout>
