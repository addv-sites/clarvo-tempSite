---
// Página 404 con marca — antes caía al default plano de nginx (sin
// error_page 404 declarado). Mismo lenguaje visual que
// portalFac/frontend/404-clarvo.html y la página real de "Portal
// desactivado" (tokens pd-* de portalFac/frontend/theme.js) — logo real
// (favicon-source.png, el cristal "V" facetado), no un ícono abstracto.
// Propuesta 5 del Artifact de 5 opciones, confirmada por el usuario.
import Layout from "../layouts/Layout.astro";
---

<Layout title="Página no encontrada | CLARVO" description="La página que buscas no existe o fue movida." noindex>
  <div class="pd-aurora" aria-hidden="true">
    <div class="pd-blob pd-b1"></div>
    <div class="pd-blob pd-b2"></div>
    <div class="pd-blob pd-b3"></div>
  </div>
  <main class="pd-contenido" role="main">
    <div class="pd-halo">
      <picture>
        <source srcset="/images/logo/favicon-source-sm.webp" type="image/webp" />
        <img class="pd-logo" src="/images/logo/favicon-source.png" alt="" width="220" height="220" />
      </picture>
    </div>
    <span class="pd-etiqueta"><span class="pd-etiqueta-punto" aria-hidden="true"></span>Error 404</span>
    <h1>Esta página no existe</h1>
    <p class="pd-cuerpo">La página que buscas no existe o fue movida. Vuelve al inicio para seguir desde ahí.</p>
    <a class="pd-boton" href="/">Ir a clarvo.mx</a>
    <p class="pd-pie"><strong>Clarvo</strong> · tu negocio en orden</p>
  </main>
</Layout>

<style>
  :root {
    --pd-navy-950: #030c22;
    --pd-navy-800: #0b1f42;
    --pd-cyan: #05dbf2;
    --pd-cyan-soft: #6fe9fb;
    --pd-ink-soft: #afc2dc;
  }

  .pd-aurora {
    position: fixed;
    inset: -10%;
    z-index: 0;
    filter: blur(60px);
    opacity: 0.55;
    pointer-events: none;
  }
  .pd-blob {
    position: absolute;
    border-radius: 50%;
    mix-blend-mode: screen;
  }
  .pd-b1 {
    width: 460px;
    height: 460px;
    top: -120px;
    left: -100px;
    background: radial-gradient(circle, var(--pd-cyan) 0%, transparent 70%);
  }
  .pd-b2 {
    width: 380px;
    height: 380px;
    bottom: -140px;
    right: -80px;
    background: radial-gradient(circle, var(--pd-navy-800) 0%, transparent 70%);
  }
  .pd-b3 {
    width: 300px;
    height: 300px;
    top: 30%;
    right: 20%;
    background: radial-gradient(circle, var(--pd-cyan-soft) 0%, transparent 75%);
    opacity: 0.5;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pd-b1 {
      animation: pd-mover1 22s ease-in-out infinite;
    }
    .pd-b2 {
      animation: pd-mover2 26s ease-in-out infinite;
    }
    .pd-b3 {
      animation: pd-mover1 19s ease-in-out infinite reverse;
    }
  }
  @keyframes pd-mover1 {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(60px, 40px);
    }
  }
  @keyframes pd-mover2 {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(-50px, -30px);
    }
  }

  .pd-contenido {
    position: relative;
    z-index: 3;
    max-width: 560px;
    margin: 0 auto;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 64px 28px 48px;
  }

  .pd-halo {
    position: relative;
    width: 170px;
    height: 170px;
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pd-halo::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(5, 219, 242, 0.28) 0%, transparent 70%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .pd-halo::before {
      animation: pd-pulso 4.5s ease-in-out infinite;
    }
    .pd-logo {
      animation: pd-float 4.5s ease-in-out infinite;
    }
  }
  @keyframes pd-pulso {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(0.92);
    }
    50% {
      opacity: 0.9;
      transform: scale(1.05);
    }
  }
  @keyframes pd-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }
  .pd-logo {
    width: 92px;
    height: 92px;
    object-fit: contain;
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 18px 30px rgba(3, 10, 25, 0.6));
  }

  .pd-etiqueta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--pd-cyan-soft);
    background: rgba(5, 219, 242, 0.1);
    border: 1px solid rgba(5, 219, 242, 0.3);
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 28px;
  }
  .pd-etiqueta-punto {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--pd-cyan);
    box-shadow: 0 0 8px var(--pd-cyan);
  }

  .pd-contenido h1 {
    font-family: var(--font-display);
    font-size: clamp(26px, 4.2vw, 36px);
    line-height: 1.18;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0 0 14px;
    color: #fff;
    text-wrap: balance;
  }
  .pd-cuerpo {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--pd-ink-soft);
    max-width: 46ch;
    margin: 0 0 30px;
  }
  .pd-boton {
    appearance: none;
    border: 1px solid rgba(5, 219, 242, 0.45);
    background: rgba(5, 219, 242, 0.08);
    color: #fff;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    padding: 11px 26px;
    border-radius: 999px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .pd-boton:hover {
    background: rgba(5, 219, 242, 0.18);
    border-color: var(--pd-cyan);
  }
  .pd-boton:focus-visible {
    outline: 2px solid var(--pd-cyan);
    outline-offset: 2px;
  }
  .pd-pie {
    margin-top: 34px;
    font-size: 12px;
    color: rgba(175, 194, 220, 0.6);
    letter-spacing: 0.02em;
  }
  .pd-pie strong {
    color: rgba(234, 243, 251, 0.78);
    font-weight: 700;
  }
</style>
