---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/masterclass/Header.astro";
import Hero from "../../components/masterclass/Hero.astro";
import Comparativa from "../../components/masterclass/Comparativa.astro";
import Pilares from "../../components/masterclass/Pilares.astro";
import Faq from "../../components/masterclass/Faq.astro";
import FinalCta from "../../components/masterclass/FinalCta.astro";
import StickyBar from "../../components/masterclass/StickyBar.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  title="CLARVO — Masterclass gratuita: deja de llevar tu negocio a ojo"
  description="Masterclass en vivo y gratuita de CLARVO: aprende a controlar inventario, utilidad real y decisiones de tu negocio en 40 minutos. Cupos limitados."
>
  <Header />
  <main>
    <Hero />
    <Comparativa />
    <Pilares />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
  <StickyBar />
</Layout>

<script>
  // Reveal-on-scroll: IntersectionObserver, nunca el evento `scroll` continuo
  // (ver skill low-impact-motion). Solo agrega una clase; la transición
  // (opacity/transform) vive en global.css bajo `.reveal`.
  const revealTargets = document.querySelectorAll(".reveal");
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 },
  );
  revealTargets.forEach((el) => revealObserver.observe(el));

  // Barra sticky móvil: se muestra cuando la tarjeta de registro del hero
  // sale de vista. IntersectionObserver también aquí, no `scroll`.
  const registro = document.querySelector("#registro");
  const stickyBar = document.querySelector<HTMLElement>("#mc-sticky-bar");

  if (registro && stickyBar) {
    const stickyObserver = new IntersectionObserver(
      ([entry]) => {
        stickyBar.classList.toggle("translate-y-0", !entry.isIntersecting);
        stickyBar.classList.toggle("translate-y-28", entry.isIntersecting);
      },
      { threshold: 0 },
    );
    stickyObserver.observe(registro);
  }
</script>
