---
import { existsSync } from "node:fs";
import path from "node:path";
import Crystal from "./Crystal.astro";

interface Props {
  devicesImage?: string;
}

const DEFAULT_DEVICES_WEBP = "/images/dashboard/devices.webp";
const DEFAULT_DEVICES_PNG = "/images/dashboard/devices.png";

function publicFileExists(publicPath: string): boolean {
  // `import.meta.url`-relative resolution breaks under `astro build`: the
  // component gets bundled into `dist/.prerender/chunks/*.mjs`, so
  // `../../public` from there resolves inside `dist/` instead of the real
  // project `public/`. `astro build`/`astro dev` both run with the project
  // root as cwd, so resolve from there instead.
  const diskPath = path.join(process.cwd(), "public", publicPath);
  return existsSync(diskPath);
}

const { devicesImage } = Astro.props;

const resolvedDevices =
  devicesImage ?? (publicFileExists(DEFAULT_DEVICES_PNG) ? DEFAULT_DEVICES_PNG : undefined);
const hasWebp = !devicesImage && publicFileExists(DEFAULT_DEVICES_WEBP);
---

<div class="stage">
  <div class="composition">
    <Crystal class="crystal pointer-events-none aspect-[1181/1201]" />

    {
      resolvedDevices ? (
        <picture>
          {hasWebp && <source srcset={DEFAULT_DEVICES_WEBP} type="image/webp" />}
          <img
            class="devices"
            src={resolvedDevices}
            alt="Vista preliminar del dashboard de CLARVO en laptop y teléfono"
            width="1507"
            height="1024"
            loading="lazy"
          />
        </picture>
      ) : (
        <div class="devices screen-placeholder">Captura del dashboard pendiente</div>
      )
    }
  </div>
</div>

<style>
  .stage {
    position: relative;
    padding: 4% 4% 2%;
  }

  .composition {
    position: relative;
    width: 100%;
  }

  .crystal {
    position: absolute;
    left: 50%;
    top: 0;
    width: 56%;
    translate: -50% 0;
    z-index: 1;
    opacity: 0.98;
    pointer-events: none;
  }

  .devices {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    margin-top: -46%;
  }

  .screen-placeholder {
    display: flex;
    aspect-ratio: 1507 / 1024;
    align-items: center;
    justify-content: center;
    border: 2px dashed #334066;
    background: #0f1834;
    padding: 0.5rem;
    text-align: center;
    font-size: 0.75rem;
    color: #94a3c4;
  }
</style>
