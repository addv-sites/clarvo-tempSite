---
import { Mail, Lock } from "@lucide/astro";
---

<div class="rounded-2xl border border-brand-border bg-brand-card/60 p-6 backdrop-blur-sm">
  <div class="flex items-start gap-4">
    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-cyan/15 text-brand-cyan">
      <Mail class="h-6 w-6" />
    </span>
    <div>
      <p class="text-lg font-semibold text-white">Sé de los primeros en acceder</p>
      <p class="text-sm text-slate-300">
        Déjanos tu correo y te avisaremos en cuanto esté disponible.
      </p>
    </div>
  </div>

  <form
    data-waitlist-form
    class="mt-5 flex flex-col gap-3 sm:flex-row"
    novalidate
  >
    <label for="waitlist-email" class="sr-only">Tu correo electrónico</label>
    <input
      id="waitlist-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="Tu correo electrónico"
      class="w-full flex-1 rounded-xl border border-brand-border bg-[#050b1c] px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-brand-cyan focus:outline-none disabled:cursor-not-allowed disabled:opacity-50"
    />

    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label for="waitlist-company">No llenar este campo</label>
      <input
        id="waitlist-company"
        name="company"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <button
      type="submit"
      data-waitlist-submit
      class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-cyan px-5 py-3 text-sm font-semibold text-[#050b1c] transition hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-50"
    >
      <span data-waitlist-submit-label>Quiero ser el primero</span>
      <span aria-hidden="true">→</span>
    </button>
  </form>

  <p
    data-waitlist-status
    role="status"
    aria-live="polite"
    class="mt-3 hidden text-sm"
  ></p>

  <p data-waitlist-privacy class="mt-3 flex items-center gap-1.5 text-xs text-slate-400">
    <Lock class="h-3.5 w-3.5" />
    Tu información está segura. No compartiremos tus datos.
  </p>
</div>

<script>
  import emailjs from "@emailjs/browser";
  import { validateWaitlistSubmission, isEmailJsConfigured } from "../lib/waitlist";

  const config = {
    serviceId: import.meta.env.PUBLIC_EMAILJS_SERVICE_ID,
    templateId: import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID,
    publicKey: import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY,
  };

  const form = document.querySelector<HTMLFormElement>("[data-waitlist-form]");
  const status = document.querySelector<HTMLParagraphElement>("[data-waitlist-status]");
  const submitButton = document.querySelector<HTMLButtonElement>("[data-waitlist-submit]");
  const submitLabel = document.querySelector<HTMLSpanElement>("[data-waitlist-submit-label]");

  function showStatus(message: string, tone: "error" | "success") {
    if (!status) return;
    status.textContent = message;
    status.classList.remove("hidden", "text-red-400", "text-emerald-400");
    status.classList.add(tone === "error" ? "text-red-400" : "text-emerald-400");
  }

  if (form && submitButton && submitLabel) {
    if (!isEmailJsConfigured(config)) {
      submitButton.disabled = true;
      const emailInput = form.querySelector<HTMLInputElement>("#waitlist-email");
      if (emailInput) emailInput.disabled = true;
      showStatus("La lista de espera todavía no está activa. Vuelve pronto.", "error");
    } else {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const email = (form.querySelector<HTMLInputElement>("#waitlist-email")?.value ?? "").trim();
        const honeypot = form.querySelector<HTMLInputElement>("#waitlist-company")?.value ?? "";

        const error = validateWaitlistSubmission({ email, honeypot });
        if (error === "spam_detected") {
          return;
        }
        if (error === "empty" || error === "invalid_format") {
          showStatus("Escribe un correo válido para continuar.", "error");
          return;
        }

        submitButton.disabled = true;
        const originalLabel = submitLabel.textContent;
        submitLabel.textContent = "Enviando...";

        try {
          await emailjs.send(
            config.serviceId as string,
            config.templateId as string,
            { email },
            { publicKey: config.publicKey as string }
          );
          showStatus("¡Listo! Te avisaremos en cuanto CLARVO esté disponible.", "success");
          form.reset();
        } catch (err) {
          console.error("Error enviando a la lista de espera:", err);
          showStatus("No se pudo enviar. Intenta de nuevo en unos minutos.", "error");
        } finally {
          submitButton.disabled = false;
          submitLabel.textContent = originalLabel;
        }
      });
    }
  }
</script>
