---
import { Package, Wallet, TrendingUp, Check } from "@lucide/astro";

const pilares = [
  {
    icon: Package,
    tag: "Pilar 01",
    title: "Inventario inteligente y sin mermas",
    description:
      "Aprende el cálculo exacto del punto de reorden. Evita tener dinero congelado en almacén o perder ventas por quedarte en ceros sin previo aviso.",
    items: [
      "Clasificación de productos más rentables",
      "Alertas de existencias mínimas en tiempo real",
      "Eliminación de mermas y fuga de mercancía",
    ],
  },
  {
    icon: Wallet,
    tag: "Pilar 02 · Clave",
    title: "Radiografía financiera y utilidad neta",
    description:
      "Aprenderás a separar tajantemente el dinero de las ventas del dinero que realmente te pertenece a ti como dueño. Nunca más confundirás flujo de caja con ganancia.",
    items: [
      "Separación de sueldo del dueño vs. utilidad",
      "Detección de gastos que desangran tu caja",
      "Hoja práctica de proyección financiera mensual",
    ],
  },
  {
    icon: TrendingUp,
    tag: "Pilar 03",
    title: "Toma de decisiones ejecutivas con datos",
    description:
      "Despídete del 'yo creo que nos fue bien'. Analiza tendencias, identifica clientes estrella y sabe exactamente cuándo es seguro reinvertir, contratar o pausar gastos.",
    items: [
      "Métricas críticas (KPIs) explicadas en español simple",
      "Automatización de cobranza y facturación limpia",
      "Plan de acción de 7 días para ordenar tu empresa",
    ],
  },
];
---

<section class="reveal px-6 py-20" id="temario">
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-widest text-brand-cyan">Temario quirúrgico</p>
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">
          Los 3 pilares que desbloquearás en 40 minutos
        </h2>
        <p class="mt-3 text-slate-300">
          Sin teoría aburrida ni tecnicismos contables enredados. Estrategias tácticas de
          aplicación inmediata para tu negocio.
        </p>
      </div>
      <a href="#registro" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-cyan transition hover:text-white">
        Asegurar un lugar en la sala
      </a>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        pilares.map(({ icon: Icon, tag, title, description, items }) => (
          <div class="flex flex-col justify-between gap-5 rounded-2xl border border-brand-border bg-brand-card/60 p-6 transition hover:bg-brand-card md:p-7">
            <div class="flex flex-col gap-3">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-cyan/15 text-brand-cyan">
                <Icon class="h-6 w-6" />
              </span>
              <p class="font-mono text-xs text-brand-cyan">{tag}</p>
              <h3 class="text-lg font-bold text-white">{title}</h3>
              <p class="text-sm text-slate-300">{description}</p>
            </div>
            <ul class="flex flex-col gap-2 text-sm text-slate-300">
              {items.map((item) => (
                <li class="flex items-start gap-2">
                  <Check class="mt-0.5 h-4 w-4 shrink-0 text-brand-cyan" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
