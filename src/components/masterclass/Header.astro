---
import { ArrowRight } from "@lucide/astro";

const NAV_LINKS = [
  { href: "#programa", label: "¿Qué aprenderás?" },
  { href: "#comparativa", label: "Comparativa" },
  { href: "#temario", label: "Temario" },
  { href: "#faq", label: "FAQs" },
];
---

<header class="sticky top-0 z-40 border-b border-brand-border bg-[#050b1c]/85 backdrop-blur-md">
  <div class="mx-auto flex h-[72px] max-w-6xl items-center justify-between gap-4 px-6">
    <a href="/" class="shrink-0" aria-label="Ir al inicio de CLARVO">
      <picture>
        <source srcset="/images/logo/logo-on-dark.webp" type="image/webp" />
        <img
          src="/images/logo/logo-on-dark.png"
          alt="CLARVO"
          class="h-8 w-auto"
          width="900"
          height="338"
        />
      </picture>
    </a>

    <nav class="hidden items-center gap-6 text-sm text-slate-300 lg:flex">
      {
        NAV_LINKS.map(({ href, label }) => (
          <a href={href} class="transition hover:text-white">
            {label}
          </a>
        ))
      }
    </nav>

    <a
      href="#registro"
      class="cta-shine inline-flex shrink-0 items-center gap-1.5 rounded-full bg-brand-cyan px-5 py-2.5 text-sm font-bold text-[#050b1c] transition hover:brightness-110"
    >
      Apartar mi lugar
      <ArrowRight class="h-4 w-4" />
    </a>
  </div>
</header>
