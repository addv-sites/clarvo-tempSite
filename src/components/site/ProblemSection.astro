---
// Propuesta 5 del artifact de animaciones (aprobada por el usuario,
// 2026-10-10): en vez de aparecer todas de golpe, cada burbuja "respira"
// en su propio ciclo — se desvanece y reaparece desfasada de las demás —
// para que parezca un flujo constante de pensamientos llegando, no una
// entrada puntual. dur/delay copiados tal cual del artifact verificado.
const thoughts = [
  { text: "¿Cuánto debo cobrar?", pos: "left-[4%] top-[6%]", dur: "3.6s", delay: "0s" },
  { text: "Facturas a la carrera", pos: "right-[2%] top-[2%]", dur: "4.4s", delay: ".6s" },
  { text: "Tickets por WhatsApp", pos: "left-[0%] top-[38%]", dur: "3.9s", delay: "1.1s" },
  { text: "¿Tengo ganancias?", pos: "right-[0%] top-[36%]", dur: "5.2s", delay: "1.7s" },
  { text: "Gastos sin control", pos: "left-[6%] bottom-[4%]", dur: "4.0s", delay: ".3s" },
  { text: "Excel por todos lados", pos: "right-[4%] bottom-[2%]", dur: "4.8s", delay: "1.4s" },
];
---

<section id="beneficios" class="bg-white py-20 text-surface-deep sm:py-28">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-6 lg:grid-cols-2">
    <div class="reveal">
      <p class="text-sm font-semibold tracking-wide text-blue-600 uppercase">¿Te suena familiar?</p>
      <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight sm:text-4xl">
        Demasiados pendientes, poca claridad.
      </h2>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600">
        Facturas en Excel, tickets por WhatsApp, gastos en un cuaderno y no
        sabes si realmente estás ganando. La información está dispareja, es
        difícil dar seguimiento y pierdes tiempo en tareas que podrían ser
        más simples.
      </p>

      <div class="mt-8 flex items-start gap-3 rounded-2xl border border-blue-100 bg-blue-50 p-5">
        <span class="text-xl" aria-hidden="true">💡</span>
        <p class="font-medium text-slate-800">
          No es un problema de herramientas.<br />
          <span class="text-blue-700">Es un problema de control.</span>
        </p>
      </div>
    </div>

    <div class="reveal relative" style="transition-delay: 120ms">
      <div class="relative mx-auto aspect-[4/3] max-w-md overflow-hidden rounded-3xl bg-slate-100">
        <img
          src="/images/site/problem-entrepreneur.png"
          alt="Dueño de un negocio pequeño revisando tickets de venta y una laptop, preocupado por no saber cuánto está ganando realmente"
          class="h-full w-full object-cover"
          width="1536"
          height="1024"
          loading="lazy"
        />
      </div>
      {thoughts.map((t) => (
        <span
          class={`thought absolute ${t.pos} hidden max-w-[9rem] rounded-xl bg-white px-3 py-2 text-xs font-medium text-slate-700 shadow-lg sm:block`}
          style={`animation-duration: ${t.dur}; animation-delay: ${t.delay};`}
        >
          {t.text}
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  /* Propuesta 5 (ver nota en el frontmatter): opacity + transform
     solamente, ver skill low-impact-motion. Envuelto en `no-preference`
     para que con reduced-motion las burbujas queden simplemente visibles
     (sin la regla opacity:0 de abajo no hay nada que anular). */
  @media (prefers-reduced-motion: no-preference) {
    .thought {
      opacity: 0;
      animation-name: thought-breathe;
      animation-timing-function: ease-in-out;
      animation-iteration-count: infinite;
      animation-fill-mode: both;
    }
  }

  @keyframes thought-breathe {
    0% {
      opacity: 0;
      transform: translateY(5px) scale(0.95);
    }
    18% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    70% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    88% {
      opacity: 0;
      transform: translateY(5px) scale(0.95);
    }
    100% {
      opacity: 0;
      transform: translateY(5px) scale(0.95);
    }
  }
</style>
