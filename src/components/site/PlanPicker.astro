---
// Punto en curso: los CTA genéricos ("Comienza gratis" del hero/solución/
// cierre) antes solo hacían scroll a #planes — nunca abrían el wizard de
// onboarding (eso lo disparaba solo el botón de cada tarjeta de plan en
// PricingSection, con su propio planClave ya resuelto). Decisión del
// usuario: esos 3 CTA deben abrir este selector compacto de plan; al
// elegir uno, dispara el mismo evento "clarvo:abrir-onboarding" que ya
// escucha OnboardingModal (OnboardingModal.tsx, client:load dentro de
// PricingSection — siempre montado en esta página, sin importar scroll).
---

<div
  class="fixed inset-0 z-[85] items-center justify-center bg-surface-deep/70 backdrop-blur-sm p-4 transition-opacity motion-reduce:transition-none"
  style="display:none;"
  role="presentation"
  data-plan-picker-overlay
>
  <div
    role="dialog"
    aria-modal="true"
    aria-label="Elige tu plan"
    tabindex="-1"
    class="relative w-full max-w-lg max-h-[88vh] overflow-y-auto rounded-3xl border border-border-specular bg-surface-card p-7 shadow-2xl outline-none"
    data-plan-picker-dialog
  >
    <button
      type="button"
      aria-label="Cerrar"
      class="absolute right-5 top-5 rounded-full p-1.5 text-text-muted transition hover:bg-surface-card-hover hover:text-text-primary"
      data-plan-picker-close
    >
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.3" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
      </svg>
    </button>

    <p class="text-sm font-semibold tracking-wide text-accent-electric uppercase">Prueba gratis 10 días</p>
    <h2 class="mt-2 font-display text-xl font-bold text-text-primary">Elige el plan con el que quieres empezar</h2>
    <p class="mt-1 text-sm text-text-secondary">Sin tarjeta de crédito. Podrás cambiar de plan después.</p>

    <div class="mt-5 space-y-3" data-plan-picker-list aria-busy="true">
      <p class="text-sm text-text-muted">Cargando planes…</p>
    </div>
  </div>
</div>

<script>
  import { publicEnv } from "../../config/publicEnv";

  interface PlanApi {
    nombre: string;
    descripcion: string;
    precio_mensual: string | null;
    precio_anual: string | null;
    destacado: number;
  }

  function moneyInt(n: number) {
    return Math.round(n).toLocaleString("es-MX");
  }

  const overlay = document.querySelector<HTMLElement>("[data-plan-picker-overlay]");
  const dialog = document.querySelector<HTMLElement>("[data-plan-picker-dialog]");
  const listEl = document.querySelector<HTMLElement>("[data-plan-picker-list]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-plan-picker-close]");

  // Mismo catálogo público que PricingSection (GET /api/public/planes) —
  // se cachea en memoria del módulo: varios clics en distintos CTA
  // durante la misma visita no deben repetir el fetch.
  let cache: PlanApi[] | null = null;
  let cargando = false;

  function abrir() {
    if (!overlay) return;
    overlay.style.display = "flex";
    document.body.style.overflow = "hidden";
    dialog?.focus();
    cargarSiHaceFalta();
  }

  function cerrar() {
    if (!overlay) return;
    overlay.style.display = "none";
    document.body.style.overflow = "";
  }

  function tarjeta(p: PlanApi): string {
    const clave = p.nombre.replace(/^CLARVO\s+/i, "").toLowerCase();
    const sinPrecio = p.precio_mensual === null;
    const precioMensual = Number(p.precio_mensual ?? 0);
    const destacado = Number(p.destacado) === 1;
    return `
      <button type="button" data-plan-picker-option data-clave="${clave}"
        class="flex w-full items-center justify-between gap-4 rounded-2xl border p-4 text-left transition ${
          destacado
            ? "border-accent-electric bg-surface-card-hover"
            : "border-border-translucent hover:border-white/30"
        }">
        <span class="min-w-0">
          <span class="flex flex-wrap items-center gap-2">
            <span class="font-display text-base font-bold text-text-primary">${p.nombre}</span>
            ${
              destacado
                ? '<span class="rounded-full bg-accent-electric px-2 py-0.5 text-[10px] font-bold text-surface-deep">Más elegido</span>'
                : ""
            }
          </span>
          <span class="mt-0.5 block truncate text-xs text-text-secondary">${p.descripcion}</span>
        </span>
        <span class="shrink-0 font-display text-lg font-extrabold text-text-primary">
          ${
            sinPrecio
              ? "Consultar"
              : `$${moneyInt(precioMensual)}<span class="text-xs font-medium text-text-muted">/mes</span>`
          }
        </span>
      </button>`;
  }

  function renderPlanes(planes: PlanApi[]) {
    if (!listEl) return;
    listEl.setAttribute("aria-busy", "false");
    listEl.innerHTML = planes.map(tarjeta).join("");
    listEl.querySelectorAll<HTMLButtonElement>("[data-plan-picker-option]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const planClave = btn.dataset.clave;
        cerrar();
        window.dispatchEvent(
          new CustomEvent("clarvo:abrir-onboarding", {
            detail: { planClave, ciclo: "mensual", modo: "prueba" },
          })
        );
      });
    });
  }

  function renderError() {
    if (!listEl) return;
    listEl.setAttribute("aria-busy", "false");
    listEl.innerHTML = `<p class="text-sm text-text-muted">No pudimos cargar los planes por ahora. <a href="#planes" class="text-accent-electric underline" data-plan-picker-fallback-link>Ver planes completos</a>.</p>`;
    listEl.querySelector("[data-plan-picker-fallback-link]")?.addEventListener("click", cerrar);
  }

  async function cargarSiHaceFalta() {
    if (cache) {
      renderPlanes(cache);
      return;
    }
    if (cargando) return;
    cargando = true;
    if (!publicEnv.apiBaseUrl) {
      renderError();
      cargando = false;
      return;
    }
    try {
      const res = await fetch(`${publicEnv.apiBaseUrl}/api/public/planes`);
      if (!res.ok) throw new Error("respuesta no-OK");
      const data = (await res.json()) as { planes: PlanApi[] };
      if (!data.planes || data.planes.length === 0) throw new Error("vacío");
      cache = data.planes;
      renderPlanes(cache);
    } catch {
      renderError();
    } finally {
      cargando = false;
    }
  }

  document.querySelectorAll<HTMLElement>("[data-open-plan-picker]").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.preventDefault();
      abrir();
    });
  });

  overlay?.addEventListener("mousedown", (e) => {
    if (e.target === overlay) cerrar();
  });
  closeBtn?.addEventListener("click", cerrar);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && overlay?.style.display === "flex") cerrar();
  });
</script>
