---
// Footer del sitio comercial — variante de ../Footer.astro con la
// navegación completa de Site.png. No se tocó Footer.astro (sigue en vivo
// en /masterclass) para evitar cualquier regresión ahí.
import Logo from "../Logo.astro";

const navLinks = [
  { href: "#inicio", label: "Inicio" },
  { href: "#beneficios", label: "Beneficios" },
  { href: "#funciones", label: "Funciones" },
  { href: "#planes", label: "Planes" },
  { href: "#testimonios", label: "Testimonios" },
  { href: "#faq", label: "FAQ" },
  { href: "#cotizador-a-medida", label: "Contacto" },
  { href: "/privacidad", label: "Aviso de privacidad" },
];
---

<footer class="border-t border-white/5 bg-surface-deep">
  <div class="mx-auto max-w-7xl px-6 py-14">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <Logo size="footer" />
        <p class="mt-3 text-sm text-text-secondary">Tu portal de gestión<br />by ADDV</p>
      </div>

      <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-text-secondary" aria-label="Navegación del footer">
        {navLinks.map((link) => (
          <a href={link.href} class="transition hover:text-white">{link.label}</a>
        ))}
      </nav>

      <div class="flex items-center gap-4">
        <a href="#" aria-label="LinkedIn" class="text-text-secondary transition hover:text-accent-electric">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56z" />
          </svg>
        </a>
        <a href="#" aria-label="YouTube" class="text-text-secondary transition hover:text-accent-electric">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
            <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.97C18.88 4 12 4 12 4s-6.88 0-8.59.45a2.78 2.78 0 0 0-1.95 1.97A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.97C5.12 20 12 20 12 20s6.88 0 8.59-.45a2.78 2.78 0 0 0 1.95-1.97A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58zM9.75 15.02V8.98L15.5 12z" />
          </svg>
        </a>
        <a href="#" aria-label="Instagram" class="text-text-secondary transition hover:text-accent-electric">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="4" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
          </svg>
        </a>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-white/5 pt-6 text-sm text-text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© 2026 CLARVO by ADDV. Todos los derechos reservados.</p>
      <div class="flex items-center gap-4">
        <button
          type="button"
          data-reopen-cookie-banner
          class="cursor-pointer border-none bg-transparent p-0 font-sans text-sm text-text-muted underline transition hover:text-white"
        >
          Preferencias de cookies
        </button>
        <span>Transformamos negocios. Agregamos valor que trasciende.</span>
        <span class="flex items-center gap-2">
          <svg viewBox="0 0 3 2" class="h-3.5 w-5 shrink-0 rounded-sm" aria-hidden="true">
            <rect width="1" height="2" x="0" fill="#006847" />
            <rect width="1" height="2" x="1" fill="#ffffff" />
            <rect width="1" height="2" x="2" fill="#ce1126" />
          </svg>
          Hecho para emprendedores
        </span>
      </div>
    </div>
  </div>
</footer>
