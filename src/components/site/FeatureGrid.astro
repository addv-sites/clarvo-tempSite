---
import { TrendingUp, Users, FileText, Package, Wallet, WifiOff, Palette, Store, History, Sparkles } from "@lucide/astro";

// Agrupación por skill ui-ux-pro-max + ux-copy (2026-10-30): los 10 ítems
// en una sola grilla plana se leían desalineados y subutilizaban el ancho
// en mobile (1 columna, mucho hueco a la derecha). 3 grupos temáticos con
// encabezado propio dan escaneo rápido y permiten 2 columnas desde mobile.
// Los títulos de grupo retoman "bajo control" del tagline de marca.
const groups = [
  {
    heading: "Dinero bajo control",
    features: [
      { icon: TrendingUp, title: "Resumen de tu negocio", desc: "Conoce tus ventas, gastos y utilidad en tiempo real." },
      { icon: Users, title: "Clientes y cobros", desc: "Dale seguimiento y cobra lo que te deben." },
      { icon: FileText, title: "Facturación fácil", desc: "Todo validado con el SAT. Sube tu constancia de situación fiscal y listo." },
      { icon: Wallet, title: "Control de gastos", desc: "Categoriza, adjunta comprobantes y conoce en qué se va tu dinero." },
    ],
  },
  {
    heading: "Operación sin fricción",
    features: [
      { icon: Package, title: "Inventario inteligente", desc: "Controla tu stock o servicios sin complicaciones." },
      { icon: WifiOff, title: "Funciona sin internet", desc: "Registra y sigue operando aunque no haya señal." },
      { icon: Store, title: "Multi-sucursal", desc: "Crece sin cambiar de sistema." },
    ],
  },
  {
    heading: "Hecho a tu medida",
    features: [
      { icon: Palette, title: "Tu marca, tu portal", desc: "Personaliza con tu logo, colores y dominio." },
      { icon: History, title: "Registro de acciones", desc: "Siempre sabes quién, cuándo y qué." },
      { icon: Sparkles, title: "Fácil de usar", desc: "Diseñado para emprendedores, no para expertos en sistemas." },
    ],
  },
];
---

<section id="funciones" class="bg-white py-20 text-surface-deep sm:py-28">
  <div class="mx-auto max-w-7xl px-6">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold tracking-wide text-blue-600 uppercase">
        Todo lo que necesitas, en un solo lugar
      </p>
      <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight sm:text-4xl">
        Funciones que simplifican tu día y hacen crecer tu negocio
      </h2>
    </div>

    <div class="mt-14 space-y-12 sm:mt-16 sm:space-y-14">
      {groups.map((group, gi) => (
        <div class={gi > 0 ? "reveal border-t border-slate-100 pt-12 sm:pt-14" : "reveal"}>
          <h3 class="font-display text-lg font-bold text-surface-deep sm:text-xl">{group.heading}</h3>
          <div class="mt-6 grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-3 lg:grid-cols-4 lg:gap-x-8">
            {group.features.map(({ icon: Icon, title, desc }, i) => (
              <div class="reveal" style={`transition-delay: ${(i % 4) * 60}ms`}>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-600 sm:h-12 sm:w-12">
                  <Icon class="h-5 w-5 sm:h-6 sm:w-6" />
                </span>
                <p class="mt-3 font-semibold text-surface-deep sm:mt-4">{title}</p>
                <p class="mt-1 text-sm leading-relaxed text-slate-600">{desc}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
