---
import { faqs } from "../../data/faq";
---

<section id="faq" class="bg-white py-20 text-surface-deep sm:py-28">
  <div class="mx-auto max-w-3xl px-6">
    <div class="reveal text-center">
      <p class="text-sm font-semibold tracking-wide text-blue-600 uppercase">Preguntas frecuentes</p>
      <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight sm:text-4xl">
        Antes de empezar, resolvamos tus dudas
      </h2>
    </div>

    <div class="mt-10 divide-y divide-slate-200 rounded-2xl border border-slate-200">
      {faqs.map((item) => (
        <details class="group p-6">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-surface-deep">
            {item.q}
            <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-slate-400 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
