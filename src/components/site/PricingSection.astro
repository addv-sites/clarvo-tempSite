---
import OnboardingModal from "../onboarding/OnboardingModal";
---

<section id="planes" class="bg-surface-canvas py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-6">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold tracking-wide text-accent-electric uppercase">Planes que crecen contigo</p>
      <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-text-primary sm:text-4xl">
        Elige el plan ideal y comienza hoy
      </h2>
      <p class="mt-2 text-sm text-text-muted">Precios + IVA</p>

      <div class="mt-8 inline-flex items-center gap-1 rounded-full border border-border-translucent bg-surface-card p-1" role="group" aria-label="Periodo de facturación">
        <button type="button" data-period-btn="monthly" aria-pressed="true" class="rounded-full px-4 py-2 text-sm font-semibold transition">
          Mensual
        </button>
        <button type="button" data-period-btn="annual" aria-pressed="false" class="rounded-full px-4 py-2 text-sm font-semibold transition">
          Anual · 2 meses gratis
        </button>
      </div>
    </div>

    <div
      class="mt-10 flex min-h-[1.5rem] items-center justify-center gap-2 text-sm font-semibold text-text-secondary"
      data-pricing-status
      aria-live="polite"
    >
      <span class="inline-flex items-center gap-2" data-pricing-status-loading>
        Actualizando precios
        <span class="inline-flex gap-1" aria-hidden="true">
          <span class="price-status-dot h-1 w-1 rounded-full bg-accent-electric"></span>
          <span class="price-status-dot h-1 w-1 rounded-full bg-accent-electric" style="animation-delay:0.15s"></span>
          <span class="price-status-dot h-1 w-1 rounded-full bg-accent-electric" style="animation-delay:0.3s"></span>
        </span>
      </span>
      <span class="hidden items-center gap-2 text-accent-electric" data-pricing-status-done>
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 6L9 17l-5-5" />
        </svg>
        Precios actualizados
      </span>
    </div>

    <div class="mt-4 grid grid-cols-1 gap-6 lg:grid-cols-4" data-pricing-grid aria-busy="true">
      {
        Array.from({ length: 4 }).map(() => (
          <div class="price-skel-card flex flex-col rounded-3xl border border-border-translucent bg-surface-card p-7" data-pricing-skeleton>
            <div class="price-skel-bar h-3 w-2/3 rounded" />
            <div class="price-skel-bar mt-6 h-8 w-1/2 rounded" />
            <div class="price-skel-bar mt-3 h-2.5 w-2/5 rounded" />
            <div class="mt-6 space-y-2.5">
              <div class="price-skel-bar h-2 w-full rounded" />
              <div class="price-skel-bar h-2 w-5/6 rounded" />
              <div class="price-skel-bar h-2 w-4/6 rounded" />
            </div>
          </div>
        ))
      }
    </div>

    {/*
      client:load, no client:visible: este componente renderiza `null`
      mientras está cerrado (sin tamaño en el DOM), así que el
      IntersectionObserver de client:visible nunca lo considera "visible"
      y jamás hidrata — el listener de "clarvo:abrir-onboarding" no se
      engancha y el CTA no hace nada. Necesita estar listo desde que
      carga la página, no cuando se desplaza a la vista.
    */}
    <OnboardingModal client:load />

    <div class="reveal mt-10 flex flex-col items-center justify-between gap-4 rounded-2xl border border-border-translucent bg-surface-card px-6 py-5 sm:flex-row">
      <div class="flex items-center gap-3">
        <span class="text-xl" aria-hidden="true">🧭</span>
        <p class="text-text-secondary">
          <span class="font-semibold text-text-primary">¿Necesitas algo a la medida?</span>
          {" "}También ofrecemos planes personalizados para adaptarnos a tu negocio.
        </p>
      </div>
      <a
        href="#cotizador-a-medida"
        class="inline-flex shrink-0 items-center gap-2 rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold text-text-primary transition hover:border-white/30"
      >
        Solicitar propuesta
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  [data-period-btn][aria-pressed="true"] {
    background: var(--color-accent-electric);
    color: var(--color-surface-deep);
  }
  [data-period-btn][aria-pressed="false"] {
    color: var(--color-text-secondary);
  }

  /* Esqueleto de precios + franja de estado (combinación 3+5 del Artifact
     de propuestas, confirmada por el usuario): el esqueleto respira en el
     cian de marca en vez de gris genérico, y la franja de texto de arriba
     anuncia en palabras lo mismo que el halo anuncia visualmente — las dos
     señales se apagan juntas al llegar los datos reales. El color base (sin
     animar) es incondicional para que quede visible incluso con
     prefers-reduced-motion; solo el pulso en sí vive en global.css, gateado
     por ese media query (mismo criterio que .price-pulse). */
  .price-skel-card {
    box-shadow: 0 0 0 1px rgba(0, 210, 255, 0.35);
  }
  .price-skel-bar {
    background: rgba(0, 210, 255, 0.16);
  }

  [data-pricing-status] {
    transition:
      opacity 0.4s ease,
      max-height 0.4s ease,
      margin 0.4s ease;
    overflow: hidden;
  }
  [data-pricing-status-done] {
    display: none;
  }
  [data-pricing-status].is-done [data-pricing-status-loading] {
    display: none;
  }
  [data-pricing-status].is-done [data-pricing-status-done] {
    display: inline-flex;
  }
  [data-pricing-status].is-gone {
    opacity: 0;
    max-height: 0;
    margin-top: 0;
  }
</style>

<script>
  import { publicEnv } from "../../config/publicEnv";

  // Punto Stripe (isla de precios, opción 1 confirmada — fetch en el
  // navegador): la ficha pública ya no viene de src/data/plans.ts
  // (prosa suelta, desincronizable del catálogo real) — viene de
  // GET /api/public/planes (control/), que solo expone planes con
  // publicado_sitio=1. El sitio sigue siendo 100% estático (nginx sirve
  // los mismos archivos de siempre); lo único nuevo es este fetch.
  interface PlanApi {
    nombre: string;
    descripcion: string;
    precio_mensual: string | null;
    precio_anual: string | null;
    max_usuarios: number | null;
    disco_cuota_mb: number | null;
    facturacion_habilitada: number;
    ventas_habilitado: number;
    gastos_habilitado: number;
    cxc_habilitado: number;
    inventarios_habilitado: number;
    auditoria_habilitado: number;
    portal_clientes_habilitado: number;
    sucursales_habilitado: number;
    marca_lookfeel_habilitado: number;
    promociones_habilitado: number;
    reportes_por_reporte_habilitado: number;
    reportes_cortes_habilitado: number;
    reportes_eliminados_habilitado: number;
    reportes_estado_inventario_habilitado: number;
    reportes_estado_tickets_habilitado: number;
  }

  function svg(inner: string) {
    return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">${inner}</svg>`;
  }
  const MOD_ICONS: Record<string, string> = {
    facturacion: svg('<path d="M7 2h8l4 4v16H7z"/><line x1="9" y1="9" x2="15" y2="9"/><line x1="9" y1="13" x2="15" y2="13"/>'),
    ventas: svg('<circle cx="9" cy="21" r="1"/><circle cx="18" cy="21" r="1"/><path d="M2 3h2l2.6 12.4a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L21 7H6"/>'),
    gastos: svg('<path d="M12 1v22M17 6H9.5a2.5 2.5 0 0 0 0 5h5a2.5 2.5 0 0 1 0 5H7"/>'),
    inventarios: svg('<path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/>'),
    cxc: svg('<rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/>'),
    auditoria: svg('<path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/>'),
    portal: svg('<circle cx="12" cy="12" r="9"/><path d="M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18M3 12h18"/>'),
    sucursales: svg('<path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/>'),
    marca: svg('<path d="M12 2l2.6 6.6L21 9l-5 4.4L17.4 21 12 17.3 6.6 21 8 13.4 3 9l6.4-.4z"/>'),
    promos: svg('<path d="M3 11l18-8-8 18-2-8-8-2z"/>'),
  };
  const ICONO_REPORTES = svg('<path d="M3 3v18h18" stroke-linecap="round" stroke-linejoin="round"/><path d="M7 16v-4M12 16V8M17 16v-7" stroke-linecap="round"/>');
  for (const c of ["reportes_por_reporte", "reportes_cortes", "reportes_eliminados", "reportes_estado_inventario", "reportes_estado_tickets"]) {
    MOD_ICONS[c] = ICONO_REPORTES;
  }
  const MOD_LABELS: Record<string, string> = {
    facturacion: "Gestión de facturas",
    ventas: "Registro de ventas",
    gastos: "Registro de gastos",
    cxc: "Cuentas por cobrar",
    inventarios: "Inventarios",
    auditoria: "Auditoría",
    portal: "Portal para tus clientes",
    sucursales: "Sucursales (grupo)",
    marca: "Personalización de marca",
    promos: "Campañas de promociones",
    reportes_por_reporte: "Reportes por periodo (automático/manual)",
    reportes_cortes: "Cortes de ventas",
    reportes_eliminados: "Reporte de eliminados",
    reportes_estado_inventario: "Estado del inventario",
    reportes_estado_tickets: "Estado de tickets",
  };
  const GRUPOS: Array<{ titulo: string; claves: string[] }> = [
    { titulo: "Operación", claves: ["ventas", "gastos", "inventarios", "cxc"] },
    { titulo: "Facturación y clientes", claves: ["facturacion", "portal"] },
    {
      titulo: "Reportes",
      claves: [
        "reportes_por_reporte",
        "reportes_cortes",
        "reportes_eliminados",
        "reportes_estado_inventario",
        "reportes_estado_tickets",
      ],
    },
    { titulo: "Organización", claves: ["sucursales", "auditoria"] },
    { titulo: "Personalización", claves: ["marca", "promos"] },
  ];
  const FLAG_POR_CLAVE: Record<string, keyof PlanApi> = {
    facturacion: "facturacion_habilitada",
    ventas: "ventas_habilitado",
    gastos: "gastos_habilitado",
    cxc: "cxc_habilitado",
    inventarios: "inventarios_habilitado",
    auditoria: "auditoria_habilitado",
    portal: "portal_clientes_habilitado",
    sucursales: "sucursales_habilitado",
    marca: "marca_lookfeel_habilitado",
    promos: "promociones_habilitado",
    reportes_por_reporte: "reportes_por_reporte_habilitado",
    reportes_cortes: "reportes_cortes_habilitado",
    reportes_eliminados: "reportes_eliminados_habilitado",
    reportes_estado_inventario: "reportes_estado_inventario_habilitado",
    reportes_estado_tickets: "reportes_estado_tickets_habilitado",
  };

  function moneyInt(n: number) {
    return Math.round(n).toLocaleString("es-MX");
  }

  // Cuota de disco real por plan (ver control/scripts/ensureSchema.js,
  // columna disco_cuota_mb) — se muestra en GB cuando alcanza 1024 MB,
  // nunca "1024 MB" crudo.
  function discoTexto(mb: number): string {
    if (mb >= 1024) {
      const gb = mb / 1024;
      return `${Number.isInteger(gb) ? gb : gb.toFixed(1)} GB`;
    }
    return `${mb} MB`;
  }

  function tarjetaHtml(plan: PlanApi, index: number): string {
    const clave = plan.nombre.replace(/^CLARVO\s+/i, "").toLowerCase();
    const destacado = clave === "controla";
    const precioMensual = Number(plan.precio_mensual ?? 0);
    const precioAnual = Number(plan.precio_anual ?? 0);
    const sinPrecio = plan.precio_mensual === null;

    const grupos = GRUPOS.map((g) => {
      const activos = g.claves.filter((c) => Number(plan[FLAG_POR_CLAVE[c]]) === 1);
      if (!activos.length) return "";
      const items = activos
        .map(
          (c) =>
            `<li class="flex items-start gap-2 text-sm text-text-secondary"><span class="mt-0.5 h-4 w-4 shrink-0 text-accent-success">${MOD_ICONS[c]}</span>${MOD_LABELS[c]}</li>`
        )
        .join("");
      return `<p class="mt-4 text-xs font-semibold uppercase tracking-wide text-text-muted">${g.titulo}</p><ul class="mt-2 space-y-2">${items}</ul>`;
    }).join("");

    return `
      <div class="reveal flex flex-col rounded-3xl border p-7 ${
        destacado
          ? "border-accent-electric bg-surface-card-hover ring-1 ring-accent-electric/50 lg:-translate-y-3"
          : "border-border-translucent bg-surface-card"
      }" style="transition-delay:${index * 80}ms">
        ${destacado ? '<span class="mb-3 inline-flex w-fit items-center rounded-full bg-accent-electric px-3 py-1 text-xs font-bold text-surface-deep">Plan más elegido</span>' : ""}
        <h3 class="font-display text-xl font-bold text-text-primary">${plan.nombre}</h3>
        <p class="mt-1 text-sm text-text-secondary">${plan.descripcion}</p>
        <p class="mt-6">
          ${
            sinPrecio
              ? '<span class="font-display text-2xl font-extrabold text-text-primary">Consultar</span>'
              : `<span class="font-display text-4xl font-extrabold text-text-primary tabular-nums" data-price-value data-monthly="${precioMensual}" data-annual="${precioAnual}" data-current="${precioMensual}">$${moneyInt(precioMensual)}</span><span class="text-text-muted" data-price-suffix>/mes</span>`
          }
        </p>
        <p class="mt-3 text-xs text-text-muted">${plan.max_usuarios ? `Hasta ${plan.max_usuarios} usuario${plan.max_usuarios === 1 ? "" : "s"}` : "Usuarios ilimitados"}</p>
        ${plan.disco_cuota_mb ? `<p class="mt-1 text-xs text-text-muted">${discoTexto(plan.disco_cuota_mb)} para tus fotos de productos y tickets</p>` : ""}
        <div class="flex-1">${grupos}</div>
        <button type="button" data-open-onboarding="${clave}" class="mt-8 inline-flex items-center justify-center rounded-full px-5 py-3 text-sm font-semibold transition ${
          destacado
            ? "cta-shine bg-accent-electric text-surface-deep hover:brightness-110"
            : "border border-white/15 text-text-primary hover:border-white/30"
        }">Comenzar con ${plan.nombre.replace(/^CLARVO\s+/i, "")}</button>
      </div>`;
  }

  // Franja de estado sobre la rejilla (combinación 3+5 del Artifact de
  // propuestas, punto en curso): confirma en palabras lo que el halo cian
  // del esqueleto ya anuncia visualmente. `statusDone()` muestra el check
  // y colapsa la franja sola tras un momento; `statusGone()` la oculta de
  // inmediato sin pasar por "actualizado" (caso: catálogo vacío, API no
  // configurada, o fetch fallido — no hay nada que confirmar).
  function statusDone(statusEl: Element | null) {
    statusEl?.classList.add("is-done");
    setTimeout(() => statusEl?.classList.add("is-gone"), 1300);
  }
  function statusGone(statusEl: Element | null) {
    statusEl?.classList.add("is-gone");
  }

  async function cargarPlanes() {
    const gridEl = document.querySelector("[data-pricing-grid]");
    const statusEl = document.querySelector("[data-pricing-status]");
    if (!gridEl) return;
    if (!publicEnv.apiBaseUrl) {
      gridEl.innerHTML = '<p class="col-span-full text-center text-sm text-text-muted">Los planes se muestran en cuanto esté conectado el catálogo en este entorno.</p>';
      gridEl.setAttribute("aria-busy", "false");
      statusGone(statusEl);
      return;
    }
    try {
      const res = await fetch(`${publicEnv.apiBaseUrl}/api/public/planes`);
      if (!res.ok) throw new Error("respuesta no-OK");
      const data = (await res.json()) as { planes: PlanApi[] };
      if (!data.planes || data.planes.length === 0) {
        gridEl.innerHTML = '<p class="col-span-full text-center text-sm text-text-muted">No hay planes publicados por ahora.</p>';
        gridEl.setAttribute("aria-busy", "false");
        statusGone(statusEl);
        return;
      }
      gridEl.innerHTML = data.planes.map((p, i) => tarjetaHtml(p, i)).join("");
      gridEl.setAttribute("aria-busy", "false");
      // Las tarjetas se inyectan DESPUÉS del fetch async — el
      // IntersectionObserver de index.astro ya corrió una sola vez al
      // cargar la página y nunca las observa, así que .reveal (opacity:0
      // de fábrica) las dejaba invisibles para siempre. El fetch en sí ya
      // es el "reveal" real: se marcan visibles de inmediato, mismo
      // criterio que prefers-reduced-motion en global.css.
      gridEl.querySelectorAll(".reveal").forEach((el) => el.classList.add("is-visible"));
      wireGrid();
      statusDone(statusEl);
    } catch {
      gridEl.innerHTML = '<p class="col-span-full text-center text-sm text-text-muted">No pudimos cargar los planes. Intenta recargar la página.</p>';
      gridEl.setAttribute("aria-busy", "false");
      statusGone(statusEl);
    }
  }

  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-period-btn]");
  const grid = document.querySelector("[data-pricing-grid]");
  const money = moneyInt;

  // Tween manual por pasos (setTimeout, no rAF): los números deben verse
  // "recalcularse" al cambiar de mensual a anual, como si el precio se
  // estuviera sumando en vivo — no solo intercambiar dos nodos ocultos.
  const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
  const STEPS = 18;
  const DURATION_MS = 450 / 1.18; // +18% de velocidad, igual que el resto del motion.

  function animatePrice(el: HTMLElement, from: number, to: number) {
    if (from === to) return;
    el.classList.remove("price-pulse");
    void el.offsetWidth; // fuerza reflow para poder re-disparar la animación CSS
    el.classList.add("price-pulse");

    let step = 0;
    const tick = () => {
      step++;
      const value = from + (to - from) * easeOutCubic(step / STEPS);
      el.textContent = `$${money(step === STEPS ? to : value)}`;
      el.dataset.current = String(step === STEPS ? to : Math.round(value));
      if (step < STEPS) setTimeout(tick, DURATION_MS / STEPS);
    };
    tick();
  }

  function setPeriod(period: "monthly" | "annual") {
    buttons.forEach((btn) => {
      btn.setAttribute("aria-pressed", String(btn.dataset.periodBtn === period));
    });

    grid?.querySelectorAll<HTMLElement>("[data-price-value]").forEach((el) => {
      const target = Number(el.dataset[period]);
      const current = Number(el.dataset.current ?? el.dataset.monthly);
      animatePrice(el, current, target);
    });

    grid?.querySelectorAll<HTMLElement>("[data-price-suffix]").forEach((el) => {
      el.textContent = period === "monthly" ? "/mes" : "/año";
    });
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const period = btn.dataset.periodBtn as "monthly" | "annual";
      setPeriod(period);
    });
  });

  // Dispara el wizard de onboarding (OnboardingModal, isla React) con el
  // plan y el ciclo de cobro que el visitante ya tenía seleccionado en
  // esta misma sección — nunca le hace repetir esa elección. Se vuelve a
  // enganchar cada vez que cargarPlanes() reemplaza el innerHTML del
  // grid (los botones viejos, con sus listeners, ya no existen en el DOM).
  function wireGrid() {
    document.querySelectorAll<HTMLButtonElement>("[data-open-onboarding]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const periodoActivo = document.querySelector<HTMLButtonElement>('[data-period-btn][aria-pressed="true"]');
        const ciclo = periodoActivo?.dataset.periodBtn === "annual" ? "anual" : "mensual";
        window.dispatchEvent(
          new CustomEvent("clarvo:abrir-onboarding", {
            detail: { planClave: btn.dataset.openOnboarding, ciclo },
          })
        );
      });
    });

    // Sincroniza las tarjetas recién insertadas con el periodo ya
    // seleccionado (si el visitante ya había tocado "Anual" antes de que
    // el fetch terminara, las tarjetas nuevas deben nacer en ese periodo,
    // no reiniciar a mensual).
    const periodoActivo = document.querySelector<HTMLButtonElement>('[data-period-btn][aria-pressed="true"]');
    if (periodoActivo?.dataset.periodBtn === "annual") {
      grid?.querySelectorAll<HTMLElement>("[data-price-value]").forEach((el) => {
        const anual = Number(el.dataset.annual);
        el.textContent = `$${money(anual)}`;
        el.dataset.current = String(anual);
      });
      grid?.querySelectorAll<HTMLElement>("[data-price-suffix]").forEach((el) => {
        el.textContent = "/año";
      });
    }
  }

  cargarPlanes();
</script>
