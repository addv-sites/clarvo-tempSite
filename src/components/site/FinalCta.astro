---
const trust = [
  { icon: "🔒", label: "Sin tarjeta de crédito" },
  { icon: "⏱️", label: "Activación en minutos" },
  { icon: "🇲🇽", label: "Soporte en español" },
];
---

<section class="bg-surface-deep py-16 sm:py-20">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-6 px-6 text-center">
    <h2 class="font-display text-2xl font-extrabold tracking-tight text-text-primary sm:text-3xl">
      Es momento de hacer crecer tu negocio
    </h2>
    <p class="max-w-xl text-text-secondary">
      Únete a los emprendedores que ya gestionan su negocio con CLARVO.
    </p>
    <a
      href="#planes"
      class="cta-shine inline-flex items-center gap-2 rounded-full bg-accent-electric px-7 py-3.5 text-base font-semibold text-surface-deep transition hover:brightness-110"
    >
      Comienza gratis
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
    <div class="mt-4 flex flex-wrap items-center justify-center gap-x-8 gap-y-2 text-sm text-text-secondary">
      {trust.map((t) => (
        <span class="flex items-center gap-2">
          <span aria-hidden="true">{t.icon}</span>
          {t.label}
        </span>
      ))}
    </div>
  </div>
</section>
