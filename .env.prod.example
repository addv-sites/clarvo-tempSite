# Copia a ".env" en este mismo directorio antes de construir la imagen de
# produccion (docker compose -f docker-compose.prod.yml build). Ninguna
# de estas variables es secreta (quedan horneadas en el HTML/JS publico
# del sitio) -- ver .env.example del repo para el detalle de cada una.
# .env NUNCA se commitea (regla global del usuario).

PUBLIC_SITE_URL=https://clarvo.mx
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_LEADS_ENDPOINT=
PUBLIC_CLARVO_API_BASE_URL=
PUBLIC_CLARVO_ONBOARDING_URL=
PUBLIC_CLARVO_APP_URL=
PUBLIC_TURNSTILE_SITE_KEY=

# Puerto en loopback del VPS donde se publica el contenedor (host nginx +
# certbot reenvia aqui). Cambiar solo si choca con otro servicio ya
# publicado en ese mismo VPS (portalFac usa 8080/4001/3306/9001).
CLARVO_SITE_PORT=8090
